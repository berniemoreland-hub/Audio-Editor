{
  "name": "bernie-wave-editor",
  "version": "2.0.12",
  "description": "Single-track VoxPro-style desktop waveform recorder and audio editor",
  "main": "main.js",
  "author": "Bernie Mack Productions",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.berniemack.waveeditor",
    "productName": "Bernie Wave Editor",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bernie-Wave-Editor-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bernie Wave Editor",
      "artifactName": "Bernie Wave Editor Setup.${ext}"
    }
  },
  "buildNumber": "012",
  "dependencies": {
    "lamejs": "1.2.1"
  }
}
